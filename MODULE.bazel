module(name = "durable_execution")

bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_go", version = "0.65.0")
bazel_dep(name = "gazelle", version = "0.54.0")
bazel_dep(name = "rules_img", version = "0.3.25")

# Go toolchain, pinned to the version in go.mod.
go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.from_file(go_mod = "//:go.mod")

# Third-party Go modules, resolved from go.mod / go.sum.
go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(go_deps, "com_github_go_playground_validator_v10", "com_github_google_uuid", "com_github_jackc_pgx_v5", "com_github_matryer_moq", "com_github_sqlc_dev_sqlc", "com_github_stretchr_testify", "com_github_testcontainers_testcontainers_go_modules_postgres", "com_github_urfave_cli_v3", "org_golang_x_sync")

# Base images. Pinned by digest; only manifests are fetched at build time,
# layer blobs are streamed from the source registry on push.
pull = use_repo_rule("@rules_img//img:pull.bzl", "pull")

pull(
    name = "alpine",
    digest = "sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf",
    platforms = [
        "linux/amd64",
        "linux/arm64",
    ],
    registry = "index.docker.io",
    repository = "library/alpine",
    tag = "3.24.4",
)

pull(
    name = "migrate",
    digest = "sha256:39b59b389634e43bb3f2d4e94bc1edef0775ec2a9a3540ce6a2cf330e5daae55",
    platforms = [
        "linux/amd64",
        "linux/arm64",
    ],
    registry = "index.docker.io",
    repository = "migrate/migrate",
    tag = "v4.18.3",
)
