load("@gazelle//:def.bzl", "DEFAULT_LANGUAGES", "gazelle", "gazelle_binary")
load("@proto_pip//:requirements.bzl", "all_whl_requirements")
load("@rules_python_gazelle_plugin//manifest:defs.bzl", "gazelle_python_manifest")
load("@rules_python_gazelle_plugin//modules_mapping:def.bzl", "modules_mapping")

# gazelle:prefix github.com/cornelmarck/durable-execution
# gazelle:exclude examples
# gazelle:exclude clients/python
# gazelle:exclude web

# Protobuf code is generated by tools/proto/gen.sh, not Bazel proto rules.
# gazelle:proto disable

# Python BUILD files are only generated for the protobuf stubs;
# gen/pb/python/BUILD.bazel turns this back on.
# gazelle:python_extension disabled

# Go (and proto, disabled above) plus rules_python's Python plugin, which must
# come after proto.
gazelle_binary(
    name = "gazelle_binary",
    languages = DEFAULT_LANGUAGES + ["@rules_python_gazelle_plugin//python"],
)

gazelle(
    name = "gazelle",
    gazelle = ":gazelle_binary",
)

# gazelle_python.yaml maps Python imports to @proto_pip wheels for gazelle,
# which finds it by walking up from each .py file. After changing the `proto`
# dependency group:
#   bazel run //:gazelle_python_manifest.update
modules_mapping(
    name = "modules_map",
    wheels = all_whl_requirements,
)

gazelle_python_manifest(
    name = "gazelle_python_manifest",
    lockfiles = "//tools/proto:requirements.txt",
    modules_mapping = ":modules_map",
    pip_repository_name = "proto_pip",
)
